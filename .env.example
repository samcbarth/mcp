# Copy to .env and fill in. These are referenced by examples/mcp.config.example.json
# via ${VAR} interpolation when the config is loaded.

# HubSpot: see https://developers.hubspot.com/docs/apps/developer-platform/build-apps/integrate-with-the-remote-hubspot-mcp-server
HUBSPOT_TOKEN=

# Make: generate an MCP token in your Make profile. https://developers.make.com/mcp-server
MAKE_MCP_TOKEN=

# Example custom remote server
INTERNAL_API_KEY=
